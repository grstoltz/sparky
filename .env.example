# Leave empty to use your Claude Code login (OAuth). Set only to use an API key instead.
ANTHROPIC_API_KEY=
# dbt Platform host. For OAuth this must be your static-subdomain Access URL, e.g. abc123.us1.dbt.com
DBT_HOST=
# Multi-cell only: set DBT_HOST=us1.dbt.com and put the prefix here
MULTICELL_ACCOUNT_PREFIX=
# Leave DBT_TOKEN empty to use OAuth (browser login on first query, Enterprise/Enterprise+).
# Set both below to use a service token instead.
DBT_TOKEN=
DBT_PROD_ENV_ID=
# Optional
SPARKY_MODEL=
