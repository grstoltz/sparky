# Leave empty to use your Claude Code login (OAuth). Set only to use an API key instead.
ANTHROPIC_API_KEY=
# dbt Platform host. For OAuth this must be your static-subdomain Access URL, e.g. abc123.us1.dbt.com
DBT_HOST=
# Multi-cell only: set DBT_HOST=us1.dbt.com and put the prefix here
MULTICELL_ACCOUNT_PREFIX=
# Leave DBT_TOKEN empty to use OAuth (browser login on first query, Enterprise/Enterprise+).
# Set both below to use a service token instead.
DBT_TOKEN=
DBT_PROD_ENV_ID=
# Optional
SPARKY_MODEL=

# Demo arms: arm1 = Text2SQL, arm2 = semantic layer only, arm3 = semantic layer + context cards
SPARKY_MODE=arm3
# Replay recorded transcripts from demo/transcripts.yaml instead of calling the model (or add ?mock=1 to the URL)
SPARKY_MOCK_MODE=
# Seconds to wait for a live answer before falling back to a recorded transcript
SPARKY_LIVE_TIMEOUT=30
# Context pack for arm3 (default: data/context_cards.json)
SPARKY_CONTEXT_PACK=
